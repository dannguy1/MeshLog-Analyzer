{
  "version": "1.0.0",
  "description": "MeshLog Agent Pattern Recognition Configuration",
  "last_updated": "2024-01-15",
  "patterns": [
    {
      "name": "wnc_timestamp",
      "pattern": "(?P<year>\\d{4}) (?P<month>\\w{3}) (?P<day>\\d{1,2}) (?P<hour>\\d{2}):(?P<minute>\\d{2}):(?P<second>\\d{2})\\.(?P<microsecond>\\d+)",
      "category": "timestamp",
      "priority": "CRITICAL",
      "description": "Standard WNC log timestamp format",
      "agent_types": ["wnc-acs", "wnc-steering", "wnc-tpyopt"],
      "validation_samples": [
        "2024 Jan 10 14:30:15.123456",
        "2024 Dec 25 09:15:30.789012",
        "2024 Feb 29 23:59:59.999999"
      ]
    },
    {
      "name": "mac_address_standard",
      "pattern": "(?P<mac>[0-9a-f]{2}(:[0-9a-f]{2}){5})",
      "category": "mac_address",
      "priority": "HIGH",
      "description": "Standard MAC address format",
      "agent_types": ["wnc-acs", "wnc-steering", "wnc-tpyopt"],
      "validation_samples": [
        "aa:bb:cc:dd:ee:ff",
        "11:22:33:44:55:66",
        "ff:ff:ff:ff:ff:ff"
      ]
    },
    {
      "name": "wnc_component_acs",
      "pattern": "wnc-acs:",
      "category": "component_id",
      "priority": "CRITICAL",
      "description": "WNC ACS component identifier",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "2024 Jan 10 14:30:15.123456 router wnc-acs: RADIO aa:bb:cc:dd:ee:ff",
        "2024 Jan 10 14:30:16.123456 router wnc-acs: trigger ACS"
      ]
    },
    {
      "name": "wnc_component_steering",
      "pattern": "wnc-steer:",
      "category": "component_id",
      "priority": "CRITICAL",
      "description": "WNC Steering component identifier",
      "agent_types": ["wnc-steering"],
      "validation_samples": [
        "2024 Jan 10 14:30:15.123456 router wnc-steer: Processing weak signal client",
        "2024 Jan 10 14:30:16.123456 router wnc-steer: beacon_measurement_map"
      ]
    },
    {
      "name": "wnc_component_tpyopt",
      "pattern": "wnc-tpyopt:",
      "category": "component_id",
      "priority": "CRITICAL",
      "description": "WNC TPYOPT component identifier",
      "agent_types": ["wnc-tpyopt"],
      "validation_samples": [
        "2024 Jan 10 14:30:15.123456 router wnc-tpyopt: State: WaitTrigger --> SendScan",
        "2024 Jan 10 14:30:16.123456 router wnc-tpyopt: Build topology success!"
      ]
    },
    {
      "name": "acs_fsm_transition",
      "pattern": "RADIO (?P<mac>[0-9a-f:]+), FSM: (?P<from_state>\\S+) --> (?P<to_state>\\S+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS FSM state transition",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "RADIO aa:bb:cc:dd:ee:ff, FSM: SERVING  --> CHECKING",
        "RADIO 11:22:33:44:55:66, FSM: CHECKING  --> SERVING",
        "RADIO ff:ee:dd:cc:bb:aa, FSM: SERVING  --> SCANNING"
      ]
    },
    {
      "name": "acs_trigger_event",
      "pattern": "trigger ACS, reason: (?P<reason>\\S+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS trigger event with reason",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "trigger ACS, reason: PERIOD",
        "trigger ACS, reason: INTERFERENCE",
        "trigger ACS, reason: MANUAL"
      ]
    },
    {
      "name": "acs_countdown",
      "pattern": "item MAC (?P<mac>[0-9a-f:]+), Sending countdown: (?P<countdown>\\d+), MinInterval delta: (?P<delta>\\d+)",
      "category": "event_specific",
      "priority": "MEDIUM",
      "description": "ACS countdown message",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "item MAC aa:bb:cc:dd:ee:ff, Sending countdown: 30, MinInterval delta: 5",
        "item MAC 11:22:33:44:55:66, Sending countdown: 60, MinInterval delta: 10"
      ]
    },
    {
      "name": "acs_preference_query",
      "pattern": "trigger CHANNEL_PREFERENCE_QUERY_MESSAGE, radio_mac: (?P<mac>[0-9a-f:]+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS channel preference query",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "trigger CHANNEL_PREFERENCE_QUERY_MESSAGE, radio_mac: aa:bb:cc:dd:ee:ff",
        "trigger CHANNEL_PREFERENCE_QUERY_MESSAGE, radio_mac: 11:22:33:44:55:66"
      ]
    },
    {
      "name": "acs_selection_trigger",
      "pattern": "trigger CHANNEL_SELECTION_REQUEST_MESSAGE, radio_mac: (?P<mac>[0-9a-f:]+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS channel selection request",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "trigger CHANNEL_SELECTION_REQUEST_MESSAGE, radio_mac: aa:bb:cc:dd:ee:ff",
        "trigger CHANNEL_SELECTION_REQUEST_MESSAGE, radio_mac: 11:22:33:44:55:66"
      ]
    },
    {
      "name": "acs_radio_info",
      "pattern": "Radio INFO: mac (?P<mac>[0-9a-f:]+), channel (?P<channel>\\d+), freq (?P<freq>[^,]+), bandwidth (?P<bandwidth>[^ ]+)",
      "category": "event_specific",
      "priority": "MEDIUM",
      "description": "ACS radio information",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "Radio INFO: mac aa:bb:cc:dd:ee:ff, channel 6, freq 2437 MHz, bandwidth 20MHz",
        "Radio INFO: mac 11:22:33:44:55:66, channel 36, freq 5180 MHz, bandwidth 40MHz"
      ]
    },
    {
      "name": "acs_channel_change_failure",
      "pattern": "Channel change failed: (?P<reason>\\S+), radio: (?P<mac>[0-9a-f:]+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS channel change failure with reason",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "Channel change failed: INTERFERENCE_TOO_HIGH, radio: aa:bb:cc:dd:ee:ff",
        "Channel change failed: NO_BETTER_CHANNEL, radio: 11:22:33:44:55:66",
        "Channel change failed: POLICY_BLOCKED, radio: ff:ee:dd:cc:bb:aa"
      ]
    },
    {
      "name": "acs_no_better_channel",
      "pattern": "No better channel found, current channel (?P<channel>\\d+) optimal",
      "category": "event_specific", 
      "priority": "HIGH",
      "description": "ACS determined current channel is optimal",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "No better channel found, current channel 6 optimal",
        "No better channel found, current channel 36 optimal"
      ]
    },
    {
      "name": "acs_interference_threshold",
      "pattern": "Interference level (?P<level>-?\\d+) dBm below threshold (?P<threshold>-?\\d+) dBm",
      "category": "event_specific",
      "priority": "MEDIUM", 
      "description": "Interference below ACS threshold",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "Interference level -65 dBm below threshold -60 dBm",
        "Interference level -70 dBm below threshold -65 dBm"
      ]
    },
    {
      "name": "acs_policy_constraint",
      "pattern": "ACS blocked by policy: (?P<policy>\\S+)",
      "category": "event_specific",
      "priority": "HIGH",
      "description": "ACS blocked by policy constraints", 
      "agent_types": ["wnc-acs"],
      "validation_samples": [
        "ACS blocked by policy: CHANNEL_BLACKLIST",
        "ACS blocked by policy: MINIMUM_STABILITY_TIME",
        "ACS blocked by policy: MANUAL_OVERRIDE"
      ]
    },
    {
      "name": "acs_dfs_radar_detected",
      "pattern": "DFS radar detected on channel (?P<channel>\\d+), switching to channel (?P<new_channel>\\d+)",
      "category": "event_specific",
      "priority": "CRITICAL",
      "description": "DFS radar detection and channel switch",
      "agent_types": ["wnc-acs"],
      "validation_samples": [
