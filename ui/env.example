# Frontend Environment Configuration
# Copy this file to .env.local and customize for your environment

# Backend API Configuration
# For local development (same machine as backend)
VITE_API_BASE_URL=http://localhost:8000

# For remote backend (different machine)
# VITE_API_BASE_URL=http://192.168.10.5:8000

# WebSocket Configuration (automatically derived from API_BASE_URL)
# VITE_WS_BASE_URL=ws://192.168.10.5:8000


