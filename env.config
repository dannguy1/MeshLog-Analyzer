# prplOS LCM Log Analysis System - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=prplOS LCM Log Analysis System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# DATA STORAGE CONFIGURATION
# =============================================================================
# Primary data directory - ALL data is stored under this path
# Use absolute paths for production deployments
DATA_DIR=/data/WNC/LCM-Logs-Data

# Subdirectories (relative to DATA_DIR)
UPLOAD_DIR=uploads
ANALYSIS_DIR=analysis
TEMP_DIR=temp
BACKUP_DIR=backups

# File size limits
MAX_FILE_SIZE=1073741824  # 1GB

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default for development) - using absolute path
DATABASE_URL=sqlite:////data/WNC/LCM-Logs-Data/prplos_analysis.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://prplos_user:prplos_pass@localhost:5432/prplos_db
# POSTGRES_DB=prplos_logs
# POSTGRES_USER=prplos_user
# POSTGRES_PASSWORD=prplos_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://0.0.0.0:3000"]

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# ANALYSIS CONFIGURATION
# =============================================================================
ANALYSIS_TIMEOUT=3600  # 1 hour
MAX_CONCURRENT_ANALYSES=5
ANOMALY_DETECTION_ENABLED=true
PREDICTIVE_ANALYTICS_ENABLED=true

# Default analysis configuration (JSON string)
DEFAULT_ANALYSIS_CONFIG={"include_raw_logs": false, "extract_structured_data": true, "perform_correlation": true, "detect_anomalies": true, "generate_summary": true, "create_visualizations": true, "embed_analysis": true}

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
MAX_WORKERS=4
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
CHUNK_SIZE=8192
TIMEOUT_SECONDS=300

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
MONITORING_ENABLED=true
ALERT_THRESHOLD_ERROR_RATE=0.1
ALERT_THRESHOLD_RESPONSE_TIME=1000
ALERT_THRESHOLD_MEMORY_USAGE=80

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# =============================================================================
# APPLICATION SPECIFIC SETTINGS
# =============================================================================
SUPPORTED_APPLICATIONS=["wnc-steer", "wnc-acs", "wnc-tpyopt", "otbr-agent"]

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================
ELASTICSEARCH_URL=
SEARCH_INDEX_PREFIX=prplos

# =============================================================================
# COLLABORATION SETTINGS
# =============================================================================
ENABLE_COLLABORATION=true
MAX_COLLABORATORS_PER_PROJECT=10

# =============================================================================
# ERROR HANDLING
# =============================================================================
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# =============================================================================
# AGENT SERVICES INTEGRATION
# =============================================================================
WNC_LOG_AGENTS_ENABLED=true
WNC_LOG_AGENTS_URL=http://localhost:8001
WNC_LOG_AGENTS_TIMEOUT=300
SHARED_DATA_PATH=/shared-data
AGENT_ANALYSIS_ENABLED=true
AGENT_RESULT_CACHE_TTL=3600
AGENT_DETECTION_CONFIDENCE_THRESHOLD=0.7
AGENT_AUTO_TRIGGER=true
AGENT_RESULT_FORMATS=["html", "json"]

# =============================================================================
# INTEGRATED AGENT CONFIGURATION
# =============================================================================
# Enable integrated agents (Python modules loaded directly)
INTEGRATED_AGENTS_ENABLED=true
INTEGRATED_AGENTS_PATH=app.agents
AGENT_DISCOVERY_AUTO_REFRESH=true
AGENT_DISCOVERY_REFRESH_INTERVAL=300

# =============================================================================
# EXTERNAL SERVICES (optional)
# =============================================================================
# LLM_API_KEY=your-llm-api-key
# LLM_API_URL=https://api.openai.com/v1

# =============================================================================
# CELERY CONFIGURATION (if using Celery)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
