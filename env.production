# prplOS LCM Log Analysis System - Production Environment Configuration

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Data Directory
DATA_DIR=/data/WNC/LCM-Logs-Data

# Database Configuration
DATABASE_URL=sqlite:///./data/prplos_analysis.db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=prplOS LCM Log Analysis System
VERSION=1.0.0

# Security Settings
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:80", "http://frontend:80"]

# File Upload Settings
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=.tar,.tar.gz,.zip

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log

